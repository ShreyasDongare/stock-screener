+# ---------- downloads ----------
+class FakeResp:
+    def __init__(self, code, content=b""):
+        self.status_code, self.content = code, content
+
+
+class FakeSession:
+    def __init__(self, resp):
+        self.resp = resp
+
+    def get(self, url, timeout=0):
+        if isinstance(self.resp, Exception):
+            raise self.resp
+        return self.resp
+
